# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://efp:efp@localhost:5432/efp_dev
REDIS_URL=redis://localhost:6379/0

# Public origin of the web app. State-changing requests from any other Origin are rejected.
WEB_ORIGIN=http://localhost:3000
# Base URL used in links inside emails (verification, password reset).
APP_PUBLIC_URL=http://localhost:3000

# Number of reverse-proxy hops to trust for client IP (0 = none).
TRUST_PROXY_HOPS=0

# Set to true behind HTTPS. Enables Secure + __Host- cookie prefix.
COOKIE_SECURE=false

# smtp | log   (log prints emails to the console; use mailpit via docker-compose for smtp)
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="eFootball Platform <no-reply@localhost>"

# Optional: check new passwords against Have I Been Pwned (k-anonymity). Fails open on network errors.
HIBP_ENABLED=false

# Uploaded images (relative to apps/api or absolute)
MEDIA_DIR=var/media
